# AlgoTrack Supabase Configuration
# Replace with your actual project URL and Publishable/Anon Key from your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Backward compatibility (optional Vite aliases)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key-here
